# Copy to .env and fill in. Every setting has a safe development default.

# development | production | test. Production turns on secure cookies and HSTS.
ENVIRONMENT=development
BASE_URL=http://localhost:8000
# Where the pricing page's "Upgrade to Pro" sends people.
CONTACT_EMAIL=sales@example.com

# Neon Postgres. In the Neon console: Connect → choose the *pooled* connection
# string (host contains "-pooler"). Paste it as-is; sslmode is handled for you.
# Leave unset for a local SQLite file (development only).
# DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.eu-central-1.aws.neon.tech/insight?sslmode=require
# (Vercel's Neon integration sets DATABASE_URL and DATABASE_URL_UNPOOLED for you.)
# The same database's direct endpoint (the host without "-pooler"), used by Alembic for migrations.
# MIGRATION_DATABASE_URL=postgresql://user:password@ep-xxxx.eu-central-1.aws.neon.tech/insight?sslmode=require
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
# Create tables on start-up. Set to false in production and run `alembic upgrade head` on deploy.
AUTO_CREATE_TABLES=true

# Redis for the shared cache (Upstash, Redis Cloud, ElastiCache…). Unset: an in-process cache.
# Use Redis whenever you run more than one app process.
# REDIS_URL=rediss://default:password@your-redis.upstash.io:6379
# (Vercel's Upstash integration sets KV_URL, which is read too.)
CACHE_TTL_SECONDS=86400
# Parsed tables kept in each process's memory.
FRAME_CACHE_ITEMS=12

# Serverless. Vercel sets VERCEL=1 itself, which turns on: no local connection pool (Neon's pooler
# does it), Secure cookies, and uploads capped at the platform's 4.5 MB request limit (4 MB of file).
# SERVERLESS=true
# PLATFORM_UPLOAD_LIMIT_MB=4

# Engine work running at once per process (uploads, new boards).
MAX_CONCURRENT_ANALYSES=4
SESSION_DAYS=30
